{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/memoria-claude/hooks/sesion-inicio.sh",
            "timeout": 30,
            "statusMessage": "Trayendo memoria-claude"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/memoria-claude/hooks/compactar.sh despues",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/memoria-claude/hooks/sesion-fin.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/memoria-claude/hooks/indices.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/memoria-claude/hooks/indice-adicional.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/memoria-claude/hooks/compactar.sh antes",
            "timeout": 60,
            "statusMessage": "Archivando y subiendo la memoria antes de compactar"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1",
    "CAVEMAN_DEFAULT_MODE": "full",
    "PONYTAIL_DEFAULT_MODE": "full"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/memoria-claude/hooks/barra-estado.sh",
    "padding": 0
  }
}
